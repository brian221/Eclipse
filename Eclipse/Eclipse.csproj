<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net481</TargetFramework>
    <RootNamespace>Eclipse</RootNamespace>
    <AssemblyName>Eclipse</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <!-- The Eclipse\ subtree contains theme/plugin media (png, txt, xaml, dll) that must
         NOT be treated as source, XAML pages, or resources. It is deployed by the
         post-build xcopy step instead. Exclude it from all default SDK globs. -->
    <EnableDefaultItems>true</EnableDefaultItems>
  </PropertyGroup>

  <!-- Keep the theme/plugin content subtree out of the compile/page/resource globs. -->
  <ItemGroup>
    <Compile Remove="Eclipse\**\*.cs" />
    <Page Remove="Eclipse\**\*.xaml" />
    <None Remove="Eclipse\**\*" />
    <Resource Remove="Eclipse\**\*" />
    <ApplicationDefinition Remove="Eclipse\**\*.xaml" />
  </ItemGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(UserProfile)\.nuget\packages\newtonsoft.json\13.0.1\lib\net45\Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="Prism">
      <HintPath>$(UserProfile)\.nuget\packages\prism.core\8.1.97\lib\net47\Prism.dll</HintPath>
    </Reference>
    <Reference Include="System.Drawing.Common">
      <HintPath>$(UserProfile)\.nuget\packages\system.drawing.common\5.0.2\lib\net461\System.Drawing.Common.dll</HintPath>
    </Reference>
    <Reference Include="WpfAnimatedGif">
      <HintPath>$(UserProfile)\.nuget\packages\wpfanimatedgif\2.0.0\lib\net40\WpfAnimatedGif.dll</HintPath>
    </Reference>
    <Reference Include="System.Speech">
      <SpecificVersion>False</SpecificVersion>
      <Private>False</Private>
    </Reference>
    <Reference Include="Unbroken.LaunchBox.Plugins">
      <HintPath>E:\Arcade\LaunchBox\Core\Unbroken.LaunchBox.Plugins.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Embedded WPF image/gif resources referenced via pack:// URIs in XAML/code. -->
  <ItemGroup>
    <Resource Include="Resources\ProgressBarImageBrush.png" />
    <Resource Include="Resources\VoiceRecognitionGif.gif" />
    <Resource Include="Resources\SettingsIcon_Grey.png" />
    <Resource Include="Resources\SettingsIcon_White.png" />
    <Resource Include="Resources\NES_BoxFront_Template.png" />
    <Resource Include="Resources\DefaultBezelHorizontal.png" />
    <Resource Include="Resources\DefaultBezelVertical.png" />
    <Resource Include="Resources\LaunchBoxLogo.png" />
    <Resource Include="Resources\EclipseSettingsIcon1.png" />
    <Resource Include="Resources\MoreInfo_Selected.png" />
    <Resource Include="Resources\MoreInfo_Unselected.png" />
    <Resource Include="Resources\PlayButton_Selected.png" />
    <Resource Include="Resources\PlayButton_Unselected.png" />
  </ItemGroup>

  <!-- Use the checked-in Resources.Designer.cs; don't let the SDK auto-generate one. -->
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Include="app.config" />
    <None Include="Resources\EclipseSettingsIcon.bmp" />
    <Content Include="Eclipse\README.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Unbroken.LaunchBox.Plugins.dll" />
  </ItemGroup>

  <Target Name="DeployEclipseTheme" AfterTargets="Build">
    <PropertyGroup>
      <EclipseStageDir>$(TargetDir)Eclipse\</EclipseStageDir>
    </PropertyGroup>
    <!-- Remove any previous staged copy (ignore failure if it doesn't exist). -->
    <RemoveDir Directories="$(EclipseStageDir)" ContinueOnError="true" />
    <!-- Stage the theme/plugin tree, then drop the built plugin dlls into Plugins, then deploy to LaunchBox. -->
    <Exec Command="xcopy &quot;$(ProjectDir)Eclipse\&quot; &quot;$(EclipseStageDir)&quot; /K /D /H /Y /E /I" />
    <Exec Command="xcopy &quot;$(TargetDir)Eclipse.dll&quot; &quot;$(EclipseStageDir)LaunchBox\Plugins&quot; /K /D /H /Y" />
    <Exec Command="xcopy &quot;$(TargetDir)WpfAnimatedGif.dll&quot; &quot;$(EclipseStageDir)LaunchBox\Plugins&quot; /K /D /H /Y" />
    <Exec Command="xcopy &quot;$(EclipseStageDir)LaunchBox\&quot; &quot;E:\Arcade\LaunchBox\&quot; /K /D /H /Y /E /I" />
  </Target>

</Project>
